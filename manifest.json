{
  "manifest_version": 3,
  "name": "CodeLearn Helper - Nhắc Code (VS Code Extension Style)",
  "version": "1.1.0",
  "description": "Tiện ích nhắc câu lệnh, IntelliSense Snippets tự động hoàn thành cho Python 3 & C++ trên CodeLearn.io theo chuẩn VS Code.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "CodeLearn Snippets Helper",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://codelearn.io/*",
        "*://*.codelearn.io/*"
      ],
      "js": [
        "data/snippets.js",
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "data/snippets.js",
        "injected/monaco-snippets.js"
      ],
      "matches": [
        "*://codelearn.io/*",
        "*://*.codelearn.io/*"
      ]
    }
  ],
  "permissions": [
    "storage",
    "clipboardWrite"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Mở bảng nhắc code CodeLearn"
    }
  }
}
